
# Finder metadata. Unanchored, so it matches at any depth -- the old rules
# were per-directory and missed web/, cards/what-helps/ and
# assets/playtest/, which is how four of these ended up committed.
.DS_Store

.Ulysses-Settings.plist
.Ulysses-Group.plist

# Claude Code local settings (machine-specific permission allowlist)
/.claude/settings.local.json

# Python bytecode cache
__pycache__/

# Generated web build outputs (build-site.py writes these; Netlify rebuilds on deploy)
/web/cards.json
/web/guidebook.html
/web/implementation.html
/web/why.html
